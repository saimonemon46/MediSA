# MediSA .gitignore

# Environment
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
venv_medisa/
*.egg-info/
dist/
build/
.pytest_cache/
*.sqlite3

# Vector store (regenerated from CSVs)
vector_store/*.faiss
vector_store/*.pkl
vector_store/*.index
vector_store/frag/

# Evaluation results
rag_pipeline/evaluation_results/
evaluation_results/

# Thesis defense documentation
*THESIS_DEFENSE*
*thesis_defense*

# Uploads
backend_django/uploads/*
!backend_django/uploads/.gitkeep
backend_django/db.sqlite3
backend_django/staticfiles/*

# Next.js & Node
frontend_next/node_modules/
frontend_next/.next/
frontend_next/out/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/
