# MediSA — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ---- LLM APIs ----
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash-lite

# ---- FastAPI AI Service ----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_RELOAD=true
AI_URL=http://localhost:8000

# ---- Django Application Backend ----
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8080
DJANGO_SECRET_KEY=medisa-django-secure-secret-key-2026
DJANGO_URL=http://localhost:8080

# ---- Next.js Web Frontend ----
NEXT_PUBLIC_DJANGO_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000

# ---- Database (MariaDB / MySQL or SQLite) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mediai_db
DB_USER=root
DB_PASS=password

# ---- File Uploads ----
MAX_UPLOAD_MB=15
UPLOAD_DIR=backend_django/uploads
